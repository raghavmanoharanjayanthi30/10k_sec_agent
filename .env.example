# Anthropic API Key (required)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LangSmith (optional but recommended for tracing)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=10k-filing-agent

# SEC EDGAR User Agent (required for MCP server)
# Format: "Your Name (your@email.com)"
SEC_EDGAR_USER_AGENT="Your Name (your@email.com)"

# API Authentication (optional)
# Leave empty or remove for development mode (no auth required)
# Set to a secure random string for production
API_KEY=

# MCP Server URL (if running separately)
MCP_SERVER_URL=http://localhost:8000
